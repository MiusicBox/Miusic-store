{
  "name": "miusic-store",
  "compatibility_date": "2026-09-10",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",              // ✅ เปลี่ยนเป็นโฟลเดอร์ที่เก็บ frontend จริง
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "exclude": ["**/node_modules/**", "**/.git/**"]   // ✅ กันไฟล์ขยะ
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "musicbox-store-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miusic-store-db",
      "database_id": "c622b79a-a82f-4c07-b352-78d12d2f781a"
    }
  ],
  "vars": {
    "R2_PUBLIC_BASE_URL": "https://pub-1c69acdb5ecc47469099f274456c724f.r2.dev"
  }
}
